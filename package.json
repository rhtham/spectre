{
  "name": "spectre",
  "private": true,
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.2",
    "yarn": "^1.22.19"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets --resolve-extensions=.js,.ts,.jsx,.tsx",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "devDependencies": {
    "esbuild": "^0.19.10"
  },
  "engines": {
    "node": "22.x",
    "yarn": "1.22.x"
  }
}
